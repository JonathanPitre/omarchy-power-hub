#!/usr/bin/env bash
# Direct sysfs tweaks. No TLP. Caller must pass a fixed verb and on|off or an EPP name.
set -euo pipefail
export PATH=/usr/bin:/bin

want() { case "$1" in on|off) return 0 ;; *) echo "bad arg" >&2; exit 2 ;; esac; }

case "${1:-}" in
  turbo)
    want "${2:-}"
    v=1; [ "$2" = on ] && v=0
    if [ -e /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
      echo "$v" > /sys/devices/system/cpu/intel_pstate/no_turbo
    elif [ -e /sys/devices/system/cpu/cpufreq/boost ]; then
      echo "$([ "$2" = on ] && echo 1 || echo 0)" > /sys/devices/system/cpu/cpufreq/boost
    else
      echo "no turbo control" >&2; exit 1
    fi
    ;;
  epp)
    case "${2:-}" in
      power|balance_power|balance_performance|performance) ;;
      *) echo "bad epp" >&2; exit 2 ;;
    esac
    wrote=0
    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
      [ -e "$f" ] || continue
      echo "$2" > "$f" && wrote=1
    done
    [ "$wrote" = 1 ]
    ;;
  epp-cpu)
    case "${2:-}" in
      ''|*[!0-9]*) echo "bad cpu index" >&2; exit 2 ;;
    esac
    case "${3:-}" in
      power|balance_power|balance_performance|performance) ;;
      *) echo "bad epp" >&2; exit 2 ;;
    esac
    [ "$#" = 3 ] || { echo "bad arguments" >&2; exit 2; }
    f="/sys/devices/system/cpu/cpu${2}/cpufreq/energy_performance_preference"
    available="${f%energy_performance_preference}energy_performance_available_preferences"
    [ -e "$f" ] || { echo "no cpu preference" >&2; exit 1; }
    [ -r "$available" ] && grep -qw -- "$3" "$available" || { echo "unsupported epp" >&2; exit 1; }
    printf '%s\n' "$3" > "$f"
    ;;
  wifi)
    want "${2:-}"
    for d in /sys/class/net/wl*; do
      [ -e "$d" ] || continue
      iw dev "$(basename "$d")" set power_save "$2"
    done
    ;;
  audio)
    want "${2:-}"
    f=/sys/module/snd_hda_intel/parameters/power_save
    [ -e "$f" ] || { echo "no audio power_save" >&2; exit 1; }
    [ "$2" = on ] && echo 10 > "$f" || echo 0 > "$f"
    ;;
  abm)
    want "${2:-}"
    v=0; [ "$2" = on ] && v=3
    wrote=0
    for f in /sys/class/drm/*/amdgpu/panel_power_savings; do
      [ -e "$f" ] || continue
      echo "$v" > "$f" && wrote=1
    done
    [ "$wrote" = 1 ]
    ;;
  pcie)
    want "${2:-}"
    v=on; [ "$2" = on ] && v=auto
    for f in /sys/bus/pci/devices/*/power/control; do
      [ -e "$f" ] || continue
      echo "$v" > "$f" 2>/dev/null || true
    done
    ;;
  usb)
    want "${2:-}"
    v=on; [ "$2" = on ] && v=auto
    for f in /sys/bus/usb/devices/*/power/control; do
      [ -e "$f" ] || continue
      dev=$(dirname "$f")
      if grep -qsx 03 "$dev"/*/bInterfaceClass 2>/dev/null; then continue; fi
      echo "$v" > "$f" 2>/dev/null || true
    done
    ;;
  charge-limit)
    n=${2:-}
    [ -n "$n" ] || exec /usr/bin/framework_tool --charge-limit
    case "$n" in
      ''|*[!0-9]*) echo "bad limit" >&2; exit 2 ;;
    esac
    [ "$n" -ge 40 ] && [ "$n" -le 100 ] || { echo "limit 40-100" >&2; exit 2; }
    exec /usr/bin/framework_tool --charge-limit "$n"
    ;;
  kblight)
    if [ "${2:-}" = "" ]; then
      exec /usr/bin/framework_tool --kblight
    fi
    case "$2" in
      ''|*[!0-9]*) echo "bad brightness" >&2; exit 2 ;;
    esac
    [ "$2" -le 100 ] || { echo "bad brightness" >&2; exit 2; }
    exec /usr/bin/framework_tool --kblight "$2"
    ;;
  fp-brightness)
    if [ "${2:-}" = "" ]; then
      exec /usr/bin/framework_tool --fp-brightness
    fi
    case "$2" in
      ''|*[!0-9]*) echo "bad brightness" >&2; exit 2 ;;
    esac
    [ "$2" -le 100 ] || { echo "bad brightness" >&2; exit 2; }
    exec /usr/bin/framework_tool --fp-brightness "$2"
    ;;
  fp-led-level)
    case "${2:-}" in
      auto|high|medium|low|ultra-low) ;;
      *) echo "bad level" >&2; exit 2 ;;
    esac
    exec /usr/bin/framework_tool --fp-led-level "$2"
    ;;
  led-sudoers)
    file=/etc/sudoers.d/omarchy-power-hub-leds
    umask 177
    printf '%s\n' \
      '%wheel ALL=(root) NOPASSWD: /usr/bin/tee /sys/class/leds/chromeos\:white\:power/brightness' \
      '%wheel ALL=(root) NOPASSWD: /usr/bin/tee /sys/class/leds/chromeos\:white\:power/trigger' > "$file"
    chmod 440 "$file"
    visudo -cf "$file" || { rm -f "$file"; exit 1; }
    ;;
  hid-wakeup)
    want "${2:-}"
    exec /usr/bin/python3 "$(dirname "$0")/hid_wakeup.py" "$2"
    ;;
  hibernate-delay)
    sec=${2:-0}
    case "$sec" in
      ''|*[!0-9]*) echo "bad delay" >&2; exit 2 ;;
    esac
    dir=/etc/systemd/sleep.conf.d
    file=$dir/90-omarchy-power-hub.conf
    mkdir -p "$dir"
    if [ "$sec" = 0 ]; then
      rm -f "$file"
    else
      printf '%s\n' '[Sleep]' "HibernateDelaySec=$sec" > "$file"
      chmod 644 "$file"
    fi
    ;;
  helper-install)
    user=$(id -nu "${PKEXEC_UID:?run via pkexec}")
    case "$user" in
      [a-z_]*) ;;
      *) echo "bad user" >&2; exit 2 ;;
    esac
    case "$user" in *[!a-z0-9_-]*) echo "bad user" >&2; exit 2 ;; esac
    src=$(dirname "$(readlink -f "$0")")
    dir=/usr/local/libexec/omarchy-power-hub
    install -d -m 755 -o root -g root "$dir"
    install -m 755 -o root -g root "$src/ops-priv" "$dir/ops-priv"
    install -m 644 -o root -g root "$src/hid_wakeup.py" "$dir/hid_wakeup.py"
    file=/etc/sudoers.d/omarchy-power-hub
    umask 177
    printf '%s\n' "$user ALL=(root) NOPASSWD: $dir/ops-priv" > "$file.new"
    visudo -cf "$file.new" >/dev/null || { rm -f "$file.new"; exit 1; }
    chmod 440 "$file.new"
    mv "$file.new" "$file"
    ;;
  *) echo "unknown" >&2; exit 2 ;;
esac
echo ok
