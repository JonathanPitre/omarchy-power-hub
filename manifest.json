{
  "schemaVersion": 1,
  "id": "omarchy-power-hub",
  "name": "Omarchy Power Hub",
  "version": "0.0.55",
  "author": "Jonathan Pitre",
  "license": "MIT",
  "description": "Theme-aware power panel with reversible Travel mode, Quick dim, optional CPU savings, battery controls, idle settings, and device status.",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "Panel.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Omarchy Power Hub",
    "description": "Battery, Travel mode, Quick dim, charge limit, and device power settings.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "pollIntervalSec": 5
    },
    "schema": [
      {
        "key": "showPercentageOnBattery",
        "type": "boolean",
        "label": "Show percentage on battery",
        "defaultValue": true
      },
      {
        "key": "alwaysShowPercentage",
        "type": "boolean",
        "label": "Show percentage when plugged in",
        "defaultValue": false
      },
      {
        "key": "pollIntervalSec",
        "type": "integer",
        "label": "Refresh interval while the panel is open (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
